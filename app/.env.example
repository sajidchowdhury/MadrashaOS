# ============================================================
# MadrashaOS — Environment Configuration Template
# ============================================================
# Copy this file to `.env` and fill in the values for your environment.
# All values marked with "dev-safe" work out of the box for local development.
# For production, replace ALL secrets with real values and rotate NEXTAUTH_SECRET.
# ============================================================

# --- Core ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/madrashaos?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_DEBUG="false"

# --- Notifications ---
#
# Email provider: "console" (dev) | "smtp" | "resend"
#
# Dev (default):
#   NOTIFICATION_PROVIDER="console" — logs emails/SMS to the terminal as
#   [NOTIFICATION:email] to=... subject=... and [NOTIFICATION:sms] to=... body=...
#   No real emails are sent. Use this for local development.
#
# Production with Resend (recommended — easiest setup):
#   1. Sign up at https://resend.com (free tier: 3,000 emails/month)
#   2. Verify your sending domain (e.g. yourdomain.org)
#   3. Generate an API key (sk_...)
#   4. Set: NOTIFICATION_PROVIDER="resend"
#          RESEND_API_KEY="sk_..."
#          EMAIL_FROM="MadrashaOS <no-reply@yourdomain.org>"
#
# Production with SMTP (self-hosted or existing mail server):
#   1. Set: NOTIFICATION_PROVIDER="smtp"
#          SMTP_HOST="smtp.yourprovider.com"
#          SMTP_PORT="587"  (465 for SSL, 587 for STARTTLS)
#          SMTP_SECURE="false"  (true for port 465)
#          SMTP_USER="your_username"
#          SMTP_PASSWORD="your_password"
#          EMAIL_FROM="MadrashaOS <no-reply@yourdomain.org>"
#
# SMS: currently console-only. Wire a real SMS provider (Twilio, BulkSMSBD)
# in v2. For v1, SMS notifications are logged to the terminal only.

NOTIFICATION_PROVIDER="console"
EMAIL_FROM="MadrashaOS <no-reply@yourdomain.org>"
EMAIL_REPLY_TO="info@yourdomain.org"

# SMTP (only needed if NOTIFICATION_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Resend (only needed if NOTIFICATION_PROVIDER=resend)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=""

# SMS (v2 — wire a real SMS provider: twilio, bulksmsbd, etc.)
SMS_PROVIDER="console"
SMS_FROM="MadrashaOS"

# --- Payment Gateway ---
# v1: manual only (cash/bank/mobile recorded as received — no gateway call).
# bKash and SSL Commerz providers are scaffolded but NOT production-ready.
# Enable in v2 after implementing webhook HMAC verification.
PAYMENT_DEFAULT_PROVIDER="manual"

# bKash (v2 — do NOT enable until HMAC verification is implemented)
# BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
# BKASH_APP_KEY=""
# BKASH_APP_SECRET=""
# BKASH_USERNAME=""
# BKASH_PASSWORD=""
# BKASH_CALLBACK_URL="http://localhost:3000/api/v1/payments/bkash/callback"

# SSL Commerz (v2 — do NOT enable until HMAC verification is implemented)
# SSLCOMMERZ_BASE_URL="https://sandbox-sslcommerz.com"
# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASSWORD=""
# SSLCOMMERZ_CALLBACK_URL="http://localhost:3000/api/v1/payments/sslcommerz/callback"
