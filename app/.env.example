# ============================================================
# MadrashaOS — Environment Configuration Template
# ============================================================
# Copy this file to `.env` and fill in the values for your environment.
# All values marked with "dev-safe" work out of the box for local development.
# For production, replace ALL secrets with real values and rotate NEXTAUTH_SECRET.
# ============================================================

# --- Core ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/madrashaos?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_DEBUG="false"

# --- Notifications ---
# Provider: "console" (dev — logs to terminal) | "smtp" | "resend"
NOTIFICATION_PROVIDER="console"
EMAIL_FROM="MadrashaOS <no-reply@yourdomain.org>"
EMAIL_REPLY_TO="info@yourdomain.org"

# SMTP (only needed if NOTIFICATION_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# Resend (only needed if NOTIFICATION_PROVIDER=resend)
RESEND_API_KEY=""

# SMS (currently console-only; wire a real SMS provider in v2)
SMS_PROVIDER="console"
SMS_FROM="MadrashaOS"

# --- Payment Gateway ---
# v1: manual only (cash/bank/mobile recorded as received — no gateway call).
# bKash and SSL Commerz providers are scaffolded but NOT production-ready.
# Enable in v2 after implementing webhook HMAC verification.
PAYMENT_DEFAULT_PROVIDER="manual"

# bKash (v2 — do NOT enable until HMAC verification is implemented)
# BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
# BKASH_APP_KEY=""
# BKASH_APP_SECRET=""
# BKASH_USERNAME=""
# BKASH_PASSWORD=""
# BKASH_CALLBACK_URL="http://localhost:3000/api/v1/payments/bkash/callback"

# SSL Commerz (v2 — do NOT enable until HMAC verification is implemented)
# SSLCOMMERZ_BASE_URL="https://sandbox-sslcommerz.com"
# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASSWORD=""
# SSLCOMMERZ_CALLBACK_URL="http://localhost:3000/api/v1/payments/sslcommerz/callback"
