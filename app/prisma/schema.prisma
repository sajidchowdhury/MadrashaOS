// ============================================================
// COMMUNICATION LAYER (4 models)
// ============================================================

/// Notice / announcement (audience-scoped).
model Notice {
  id              String         @id @default(uuid()) @db.Uuid
  organization_id String         @db.Uuid
  branch_id       String?        @db.Uuid
  title           String
  title_bn        String?
  body            String
  body_bn         String?
  audience        NoticeAudience @default(all)
  audience_filter String? // e.g. "class-5" or "section-5-A". NULL when audience is `all` or `staff`.
  recipient_count Int            @default(0)
  category        String         @default("general") // admission | holiday | event | exam | general
  sent_by         String         @db.Uuid
  sent_at         DateTime?      @db.Timestamptz
  is_pinned       Boolean        @default(false)
  expires_at      DateTime?      @db.Date
  status          String         @default("draft") // draft | scheduled | sent
  attachment_url  String?
  is_sms_sent     Boolean        @default(false)
  created_at      DateTime       @default(now()) @db.Timestamptz
  updated_at      DateTime       @updatedAt @db.Timestamptz
  deleted_at      DateTime?      @db.Timestamptz
  created_by      String?        @db.Uuid
  updated_by      String?        @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  sender       User         @relation("NoticeSentBy", fields: [sent_by], references: [id])

  @@index([organization_id, branch_id])
  @@index([branch_id, audience, sent_at])
  @@index([category])
  @@index([status])
  @@index([sent_at])
  @@index([is_pinned])
  @@index([expires_at])
  @@index([deleted_at])
  @@map("notices")
}

/// Uploaded document (PDF, image, Excel, Word, ...).
model Document {
  id                String       @id @default(uuid()) @db.Uuid
  organization_id   String       @db.Uuid
  branch_id         String?      @db.Uuid
  name              String
  original_filename String
  storage_url       String
  mime_type         String
  type              DocumentType @default(other)
  size_bytes        BigInt       @default(0)
  sha256            String?
  uploaded_by       String       @db.Uuid
  uploaded_at       DateTime     @default(now()) @db.Timestamptz
  visibility        String       @default("staff") // public | staff | authority
  tags              Json         @default("[]")
  description       String?
  expires_at        DateTime?    @db.Timestamptz
  download_count    Int          @default(0)
  created_at        DateTime     @default(now()) @db.Timestamptz
  updated_at        DateTime     @updatedAt @db.Timestamptz
  deleted_at        DateTime?    @db.Timestamptz
  created_by        String?      @db.Uuid
  updated_by        String?      @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  uploader     User         @relation("DocumentUploadedBy", fields: [uploaded_by], references: [id])

  @@index([organization_id, branch_id])
  @@index([name])
  @@index([type])
  @@index([visibility])
  @@index([uploaded_at])
  @@index([deleted_at])
  @@map("documents")
}

/// Generated report (filtered + async export).
model Report {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  name            String
  report_type     String // finance | attendance | students | inventory | academic | audit | custom
  parameters      Json      @default("{}")
  format          String    @default("pdf") // pdf | csv | xlsx | json
  storage_url     String?
  status          String    @default("queued") // queued | running | completed | failed
  size_bytes      BigInt?
  generated_by    String    @db.Uuid
  started_at      DateTime? @db.Timestamptz
  completed_at    DateTime? @db.Timestamptz
  error_message   String?
  row_count       Int?
  expires_at      DateTime? @db.Timestamptz
  is_finance      Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  generator    User         @relation("ReportGeneratedBy", fields: [generated_by], references: [id])

  @@index([organization_id, branch_id])
  @@index([name])
  @@index([report_type])
  @@index([status])
  @@index([generated_by])
  @@index([started_at])
  @@index([deleted_at])
  @@map("reports")
}

/// Approval workflow (no self-approve — D16: requested_by ≠ decided_by).
model Approval {
  id               String         @id @default(uuid()) @db.Uuid
  organization_id  String         @db.Uuid
  branch_id        String?        @db.Uuid
  type             ApprovalType
  title            String
  description      String?
  amount           Decimal?       @db.Decimal(14, 2)
  payload          Json           @default("{}")
  status           ApprovalStatus @default(pending)
  requested_by     String         @db.Uuid
  requested_at     DateTime       @default(now()) @db.Timestamptz
  decided_by       String?        @db.Uuid
  decided_at       DateTime?      @db.Timestamptz
  decision_note    String?
  rejection_reason String?
  delegated_to     String?        @db.Uuid
  expires_at       DateTime?      @db.Timestamptz
  entity_type      String?
  entity_id        String?        @db.Uuid
  created_at       DateTime       @default(now()) @db.Timestamptz
  updated_at       DateTime       @updatedAt @db.Timestamptz
  deleted_at       DateTime?      @db.Timestamptz
  created_by       String?        @db.Uuid
  updated_by       String?        @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  requester    User         @relation("ApprovalRequestedBy", fields: [requested_by], references: [id])
  decider      User?        @relation("ApprovalDecidedBy", fields: [decided_by], references: [id])
  delegate     User?        @relation("ApprovalDelegatedTo", fields: [delegated_to], references: [id])

  @@index([organization_id, branch_id])
  @@index([type])
  @@index([title])
  @@index([status])
  @@index([requested_by])
  @@index([decided_by])
  @@index([requested_at])
  @@index([expires_at])
  @@index([deleted_at])
  @@map("approvals")
}

// ============================================================
// Platform Layer — Idempotency Records (Phase 4)
// ============================================================
// Replaces the in-memory Map in src/lib/auth/with-idempotency.ts
// with a Postgres-backed table so idempotency survives server
// restarts and works across multiple instances (serverless-safe).
// TTL: 24 hours per SRS §6.5. Expired rows are lazily swept.

model IdempotencyRecord {
  id            String   @id @default(uuid()) @db.Uuid
  key           String   @unique // the Idempotency-Key header value
  organization_id String? @db.Uuid
  method        String   // POST | PUT | PATCH | DELETE
  path          String   // the API route path
  status_code   Int      // HTTP status of the original response
  response_body Json     // the JSON body to replay
  content_type  String   @default("application/json")
  expires_at    DateTime @db.Timestamptz
  created_at    DateTime @default(now()) @db.Timestamptz

  @@index([expires_at])
  @@index([organization_id])
  @@map("idempotency_records")
}
