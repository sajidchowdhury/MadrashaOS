// ============================================================
// MadrashaOS — Prisma Schema (Phase B0.3)
// ============================================================
// Implements the 52-table PostgreSQL schema defined in:
//   - docs/ERD.md             (52 tables, 98 relations, 14 enums)
//   - docs/DATA_DICTIONARY.md  (per-table field definitions)
//   - src/lib/mock/types.ts    (data contract from the mock layer)
//
// Layer breakdown:
//   Foundation    (10) — organizations, branches, users, roles, permissions,
//                          role_permissions, audit_logs, module_configs,
//                          security_policies, backup_records
//   People         (9) — classes, sections, students, guardians,
//                          student_guardians, teachers, employees,
//                          admissions, teacher_assignments
//   Academic       (8) — subjects, routines, attendance_sessions,
//                          attendance_records, exams, marks, results,
//                          student_history
//   Finance        (9) — accounts, fee_plans, fee_installments,
//                          fee_payments, scholarships, ledger_entries,
//                          cash_bank_transfers, zakat_transactions, donations
//   Operations    (12) — inventory_items, purchases, purchase_items,
//                          suppliers, assets, hostel_rooms, hostel_beds,
//                          meal_plans, library_books, library_issues,
//                          vehicles, fuel_logs
//   Communication  (4) — notices, documents, reports, approvals
//                       ──────────────────────
//                       Total: 52 tables
//
// Conventions:
//   • snake_case field names (mirror DB columns; no @map needed)
//   • PascalCase model names mapped via @@map to snake_case plural tables
//   • UUID PKs (uuid_generate_v4 via Prisma default)
//   • Money = Decimal(14, 2); JSONB = Json
//   • Soft-delete (deleted_at) on every table
//   • Multi-tenant scoping (organization_id, branch_id) on every table
//     except organizations (root) and permissions (global catalog)
//   • created_by / updated_by kept as plain UUID scalars (audit fields)
//     to avoid bloating User with 100+ back-relations
// ============================================================

generator client {
  provider = "prisma-client-js"
  // Generate into src/generated/prisma so it's co-located with code
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS (15)
// ============================================================

/// The 8 role code values documented in src/stores/types.ts.
/// NOTE: Named `RoleCode` (not `Role`) because Prisma forbids an enum and
/// a model from sharing a name. The `roles.code` column is a plain varchar
/// (to allow extension per the ERD), so this enum is a typing reference —
/// it is not used as a column type.
enum RoleCode {
  super_admin
  authority
  administrator
  accountant
  teacher
  storekeeper
  guardian
  student
}

enum Gender {
  male
  female
}

enum StudentStatus {
  active
  graduated
  withdrawn
}

enum AdmissionStatus {
  applied
  interviewed
  approved
  registered
  rejected
}

enum AttendanceStatus {
  present
  absent
  late
  leave
}

enum ExamStatus {
  draft
  active
  published
}

enum MarkGrade {
  a_plus
  a
  b
  c
  d
  f
}

/// C6 / D18 — Zakat fund isolation. General vs Zakat accounts cannot mix.
enum FundType {
  general
  zakat
}

enum AccountType {
  asset
  liability
  equity
  income
  expense
}

enum FeeMethod {
  cash
  bank
  mobile
}

/// Golden Flow §3.6 — ledger entry lifecycle.
enum LedgerStatus {
  posted
  pending
  rejected
}

enum ApprovalType {
  expense
  purchase
  discount
  admission
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum NoticeAudience {
  all
  class
  guardians
  staff
}

enum DocumentType {
  pdf
  word
  image
  excel
  other
}

// ============================================================
// FOUNDATION LAYER (10 models)
// ============================================================

/// Top-level tenant — a single madrasha trust. Root of the multi-tenant tree.
/// Omits organization_id (it IS the tenant root) and branch_id (platform-level).
model Organization {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  name_bn          String
  slug             String    @unique
  phone            String?
  email            String?
  address          String?
  logo_url         String?
  website_url      String?
  established_year Int?
  settings         Json      @default("{}")
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz
  deleted_at       DateTime? @db.Timestamptz
  created_by       String?   @db.Uuid
  updated_by       String?   @db.Uuid

  branches            Branch[]
  users               User[]
  roles               Role[]
  role_permissions    RolePermission[]
  module_configs      ModuleConfig[]
  security_policies   SecurityPolicy[]
  backup_records      BackupRecord[]
  audit_logs          AuditLog[]
  classes             Class[]
  sections            Section[]
  students            Student[]
  guardians           Guardian[]
  student_guardians   StudentGuardian[]
  teachers            Teacher[]
  employees           Employee[]
  admissions          Admission[]
  teacher_assignments TeacherAssignment[]
  subjects            Subject[]
  routines            Routine[]
  attendance_sessions AttendanceSession[]
  attendance_records  AttendanceRecord[]
  exams               Exam[]
  marks               Mark[]
  results             Result[]
  student_histories   StudentHistory[]
  accounts            Account[]
  fee_plans           FeePlan[]
  fee_installments    FeeInstallment[]
  fee_payments        FeePayment[]
  scholarships        Scholarship[]
  ledger_entries      LedgerEntry[]
  cash_bank_transfers CashBankTransfer[]
  zakat_transactions  ZakatTransaction[]
  donations           Donation[]
  inventory_items     InventoryItem[]
  purchases           Purchase[]
  purchase_items      PurchaseItem[]
  suppliers           Supplier[]
  assets              Asset[]
  hostel_rooms        HostelRoom[]
  hostel_beds         HostelBed[]
  meal_plans          MealPlan[]
  library_books       LibraryBook[]
  library_issues      LibraryIssue[]
  vehicles            Vehicle[]
  fuel_logs           FuelLog[]
  notices             Notice[]
  documents           Document[]
  reports             Report[]
  approvals           Approval[]

  @@index([deleted_at])
  @@index([created_at])
  @@map("organizations")
}

/// Campus / branch under an organization. Three seeded: Dhaka, Chittagong, Sylhet.
model Branch {
  id               String    @id @default(uuid()) @db.Uuid
  organization_id  String    @db.Uuid
  code             String
  name             String
  name_bn          String
  address          String?
  phone            String?
  email            String?
  established_year Int?
  is_active        Boolean   @default(true)
  latitude         Decimal?  @db.Decimal(10, 7)
  longitude        Decimal?  @db.Decimal(10, 7)
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz
  deleted_at       DateTime? @db.Timestamptz
  created_by       String?   @db.Uuid
  updated_by       String?   @db.Uuid

  organization        Organization        @relation(fields: [organization_id], references: [id])
  users               User[]
  classes             Class[]
  sections            Section[]
  students            Student[]
  guardians           Guardian[]
  teachers            Teacher[]
  employees           Employee[]
  roles               Role[]
  role_permissions    RolePermission[]
  admissions          Admission[]
  subjects            Subject[]
  routines            Routine[]
  teacher_assignments TeacherAssignment[]
  student_guardians   StudentGuardian[]
  audit_logs          AuditLog[]
  module_configs      ModuleConfig[]
  security_policies   SecurityPolicy[]
  backup_records      BackupRecord[]
  attendance_sessions AttendanceSession[]
  attendance_records  AttendanceRecord[]
  exams               Exam[]
  marks               Mark[]
  results             Result[]
  student_histories   StudentHistory[]
  accounts            Account[]
  fee_plans           FeePlan[]
  fee_installments    FeeInstallment[]
  fee_payments        FeePayment[]
  scholarships        Scholarship[]
  ledger_entries      LedgerEntry[]
  cash_bank_transfers CashBankTransfer[]
  zakat_transactions  ZakatTransaction[]
  donations           Donation[]
  inventory_items     InventoryItem[]
  purchases           Purchase[]
  purchase_items      PurchaseItem[]
  suppliers           Supplier[]
  assets              Asset[]
  hostel_rooms        HostelRoom[]
  hostel_beds         HostelBed[]
  meal_plans          MealPlan[]
  library_books       LibraryBook[]
  library_issues      LibraryIssue[]
  vehicles            Vehicle[]
  fuel_logs           FuelLog[]
  notices             Notice[]
  documents           Document[]
  reports             Report[]
  approvals           Approval[]
  assets_transferred  Asset[]             @relation("AssetTransferredToBranch")

  @@unique([organization_id, code])
  @@index([organization_id])
  @@index([deleted_at])
  @@index([created_at])
  @@map("branches")
}

/// Login accounts. Each user has exactly one role_id and is scoped to a branch_id.
model User {
  id                 String    @id @default(uuid()) @db.Uuid
  organization_id    String    @db.Uuid
  branch_id          String?   @db.Uuid
  role_id            String    @db.Uuid
  name               String
  name_bn            String?
  email              String
  phone              String?
  password_hash      String
  avatar_initial     String?   @db.VarChar(2)
  avatar_url         String?
  status             String    @default("active") // active | disabled | locked
  last_login_at      DateTime? @db.Timestamptz
  last_login_ip      String?
  mfa_secret         String?
  mfa_enabled        Boolean   @default(false)
  failed_login_count Int       @default(0)
  locked_until       DateTime? @db.Timestamptz
  preferences        Json      @default("{}")
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @updatedAt @db.Timestamptz
  deleted_at         DateTime? @db.Timestamptz
  created_by         String?   @db.Uuid
  updated_by         String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  role         Role         @relation(fields: [role_id], references: [id])

  // Profile back-relations (1:1 with users)
  teacher_profile  Teacher?
  employee_profile Employee?

  // Guardian linked account
  guardian_profile Guardian?

  // Audit / backup actor
  audit_logs_actor AuditLog[]       @relation("AuditLogActor")
  backup_records   BackupRecord[]   @relation("BackupRecordTriggeredBy")
  role_permissions RolePermission[] @relation("RolePermissionGrantedBy")

  // People-layer actor relations
  admissions_requested        Admission[]         @relation("AdmissionRequestedBy")
  admissions_decided          Admission[]         @relation("AdmissionDecidedBy")
  attendance_sessions_taken   AttendanceSession[] @relation("AttendanceTakenBy")
  attendance_records_recorded AttendanceRecord[]  @relation("AttendanceRecordedBy")
  exams_published             Exam[]              @relation("ExamPublishedBy")
  marks_entered               Mark[]              @relation("MarkEnteredBy")
  results_generated           Result[]            @relation("ResultGeneratedBy")
  student_history_actions     StudentHistory[]    @relation("StudentHistoryActionBy")

  // Finance-layer actor relations
  fee_payments_collected        FeePayment[]       @relation("FeePaymentCollectedBy")
  scholarships_approved         Scholarship[]      @relation("ScholarshipApprovedBy")
  ledger_entries_posted         LedgerEntry[]      @relation("LedgerPostedBy")
  ledger_entries_approved       LedgerEntry[]      @relation("LedgerApprovedBy")
  cash_bank_transfers_initiated CashBankTransfer[] @relation("TransferInitiatedBy")
  zakat_transactions_handled    ZakatTransaction[] @relation("ZakatHandledBy")
  donations_confirmed           Donation[]         @relation("DonationConfirmedBy")

  // Operations-layer actor relations
  purchases_requested     Purchase[]     @relation("PurchaseRequestedBy")
  purchases_approved      Purchase[]     @relation("PurchaseApprovedBy")
  assets_disposed         Asset[]        @relation("AssetDisposedBy")
  meal_plans_prepared     MealPlan[]     @relation("MealPreparedBy")
  library_issues_created  LibraryIssue[] @relation("LibraryIssuedBy")
  library_issues_returned LibraryIssue[] @relation("LibraryReturnedTo")
  fuel_logs               FuelLog[]      @relation("FuelLoggedBy")

  // Communication-layer actor relations
  notices_sent        Notice[]   @relation("NoticeSentBy")
  documents_uploaded  Document[] @relation("DocumentUploadedBy")
  reports_generated   Report[]   @relation("ReportGeneratedBy")
  approvals_requested Approval[] @relation("ApprovalRequestedBy")
  approvals_decided   Approval[] @relation("ApprovalDecidedBy")
  approvals_delegated Approval[] @relation("ApprovalDelegatedTo")

  @@unique([organization_id, email])
  @@index([organization_id, branch_id])
  @@index([role_id])
  @@index([deleted_at])
  @@index([created_at])
  @@map("users")
}

/// The 8 personas from src/stores/types.ts. System roles cannot be deleted.
/// organization_id is NULL for system/platform roles (super-admin).
/// `code` is a varchar (not a Postgres enum) to allow runtime extension —
/// see the `RoleCode` Prisma enum for the 8 seeded values.
model Role {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String?   @db.Uuid
  branch_id       String?   @db.Uuid
  code            String // super_admin | authority | administrator | accountant | teacher | storekeeper | guardian | student
  name            String
  name_bn         String?
  description     String?
  is_system       Boolean   @default(false)
  is_platform     Boolean   @default(false)
  priority        Int       @default(100)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization     Organization?    @relation(fields: [organization_id], references: [id])
  branch           Branch?          @relation(fields: [branch_id], references: [id])
  users            User[]
  role_permissions RolePermission[]

  @@unique([organization_id, code])
  @@index([organization_id])
  @@index([branch_id])
  @@index([deleted_at])
  @@map("roles")
}

/// Global catalog of 110+ permission codes from src/lib/auth/permissions.ts.
/// No organization_id / branch_id — globally seeded. This is the documented
/// exception to the multi-tenant rule (see ERD §"Base Mixin").
model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(64)
  module      String // foundation | people | academic | finance | operations | communication
  name        String
  description String?
  is_system   Boolean   @default(true)
  is_scoped   Boolean   @default(false) // true for *.view.own / *.create.own
  created_at  DateTime  @default(now()) @db.Timestamptz
  updated_at  DateTime  @updatedAt @db.Timestamptz
  deleted_at  DateTime? @db.Timestamptz

  role_permissions RolePermission[]

  @@index([module])
  @@index([deleted_at])
  @@map("permissions")
}

/// M:M junction between roles and permissions. Carries the grant timestamp.
model RolePermission {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  role_id         String    @db.Uuid
  permission_id   String    @db.Uuid
  granted_at      DateTime  @default(now()) @db.Timestamptz
  granted_by      String?   @db.Uuid
  scope_note      String?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  role         Role         @relation(fields: [role_id], references: [id])
  permission   Permission   @relation(fields: [permission_id], references: [id])
  granter      User?        @relation("RolePermissionGrantedBy", fields: [granted_by], references: [id])

  @@unique([role_id, permission_id])
  @@index([organization_id, branch_id])
  @@index([role_id])
  @@index([permission_id])
  @@index([deleted_at])
  @@map("role_permissions")
}

/// Field-level diff audit trail (SRS §2.1.4, §3.4, BP5).
/// Every write to audited entities produces a row here.
model AuditLog {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  actor_user_id   String?   @db.Uuid
  action          String // create | update | delete | login | logout | approve | reject | ...
  entity_type     String // students | fee_payments | ...
  entity_id       String    @db.Uuid
  old_values      Json? // full row snapshot before change (NULL for create)
  new_values      Json? // full row snapshot after change (NULL for delete)
  diff_summary    String?
  ip_address      String?
  user_agent      String?
  request_id      String?
  session_id      String?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  actor        User?        @relation("AuditLogActor", fields: [actor_user_id], references: [id])

  @@index([organization_id, branch_id])
  @@index([entity_type, entity_id])
  @@index([actor_user_id])
  @@index([action])
  @@index([created_at])
  @@index([deleted_at])
  @@map("audit_logs")
}

/// Per-branch module on/off toggles (SRS §2.1.2). When branch_id is NULL,
/// the row is the org-level default.
model ModuleConfig {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  module_key      String // fees | accounting | zakat | hostel | library | ...
  is_enabled      Boolean   @default(true)
  config          Json      @default("{}")
  display_order   Int       @default(100)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])

  @@unique([organization_id, branch_id, module_key])
  @@index([organization_id, branch_id])
  @@index([deleted_at])
  @@map("module_configs")
}

/// Password rules, MFA policy, session TTL, IP allowlist.
/// One row per organization (1:1 enforced by UNIQUE).
model SecurityPolicy {
  id                             String    @id @default(uuid()) @db.Uuid
  organization_id                String    @db.Uuid
  branch_id                      String?   @db.Uuid
  password_min_length            Int       @default(8)
  password_require_special       Boolean   @default(true)
  password_require_digit         Boolean   @default(true)
  password_require_upper         Boolean   @default(true)
  password_expiry_days           Int       @default(90)
  password_history_count         Int       @default(5)
  mfa_required                   Boolean   @default(false)
  mfa_required_roles             Json      @default("[]")
  session_ttl_minutes            Int       @default(15)
  refresh_ttl_days               Int       @default(7)
  max_concurrent_sessions        Int       @default(3)
  ip_allowlist                   Json      @default("[]")
  failed_login_lockout_threshold Int       @default(5)
  failed_login_lockout_minutes   Int       @default(15)
  created_at                     DateTime  @default(now()) @db.Timestamptz
  updated_at                     DateTime  @updatedAt @db.Timestamptz
  deleted_at                     DateTime? @db.Timestamptz
  created_by                     String?   @db.Uuid
  updated_by                     String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])

  @@unique([organization_id])
  @@index([organization_id, branch_id])
  @@index([deleted_at])
  @@map("security_policies")
}

/// Backup run history (manual + scheduled).
model BackupRecord {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  backup_type     String // manual | scheduled | pre-migration
  status          String    @default("running") // running | completed | failed | partial
  size_bytes      BigInt?
  storage_url     String?
  storage_type    String? // local | s3 | gcs | azure
  checksum_sha256 String?
  error_message   String?
  triggered_by    String?   @db.Uuid
  started_at      DateTime  @default(now()) @db.Timestamptz
  completed_at    DateTime? @db.Timestamptz
  table_count     Int?
  row_count       BigInt?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  triggerer    User?        @relation("BackupRecordTriggeredBy", fields: [triggered_by], references: [id])

  @@index([organization_id, branch_id])
  @@index([status])
  @@index([started_at])
  @@index([deleted_at])
  @@map("backup_records")
}

// ============================================================
// PEOPLE LAYER (9 models)
// ============================================================

/// Academic grade level (e.g. "Class 5"). Branch-scoped.
model Class {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  name            String
  name_bn         String
  level           Int
  stream          String? // general | hifz | alim | nazera
  is_active       Boolean   @default(true)
  display_order   Int       @default(100)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization         Organization        @relation(fields: [organization_id], references: [id])
  branch               Branch?             @relation(fields: [branch_id], references: [id])
  sections             Section[]
  students             Student[]
  routines             Routine[]
  attendance_sessions  AttendanceSession[]
  exams                Exam[]
  teacher_assignments  TeacherAssignment[]
  student_history_from StudentHistory[]    @relation("ClassFromHistory")
  student_history_to   StudentHistory[]    @relation("ClassToHistory")

  @@unique([organization_id, branch_id, name])
  @@index([organization_id, branch_id])
  @@index([deleted_at])
  @@map("classes")
}

/// Section within a class (A, B, C). Each section has a class teacher.
model Section {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  class_id        String    @db.Uuid
  name            String
  capacity        Int       @default(40)
  teacher_id      String?   @db.Uuid // class teacher
  room            String?
  is_active       Boolean   @default(true)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization         Organization        @relation(fields: [organization_id], references: [id])
  branch               Branch?             @relation(fields: [branch_id], references: [id])
  class                Class               @relation(fields: [class_id], references: [id])
  class_teacher        Teacher?            @relation("SectionClassTeacher", fields: [teacher_id], references: [id])
  students             Student[]
  routines             Routine[]
  attendance_sessions  AttendanceSession[]
  teacher_assignments  TeacherAssignment[]
  student_history_from StudentHistory[]    @relation("SectionFromHistory")
  student_history_to   StudentHistory[]    @relation("SectionToHistory")

  @@unique([class_id, name])
  @@index([organization_id, branch_id])
  @@index([class_id])
  @@index([deleted_at])
  @@map("sections")
}

/// Enrolled student. Linked to class_id + section_id. Can have multiple
/// guardians via student_guardians. Risk R4: every class change is logged in
/// student_history.
model Student {
  id                String        @id @default(uuid()) @db.Uuid
  organization_id   String        @db.Uuid
  branch_id         String?       @db.Uuid
  code              String
