  id                String      @id @default(uuid()) @db.Uuid
  organization_id   String      @db.Uuid
  branch_id         String?     @db.Uuid
  code              String
  name              String
  name_bn           String?
  type              AccountType
  fund              FundType    @default(general)
  balance           Decimal     @default(0) @db.Decimal(14, 2)
  currency          String      @default("BDT") @db.VarChar(3)
  parent_account_id String?     @db.Uuid
  is_active         Boolean     @default(true)
  is_bank           Boolean     @default(false)
  bank_name         String?
  bank_account_no   String?
  is_cash           Boolean     @default(false)
  description       String?
  created_at        DateTime    @default(now()) @db.Timestamptz
  updated_at        DateTime    @updatedAt @db.Timestamptz
  deleted_at        DateTime?   @db.Timestamptz
  created_by        String?     @db.Uuid
  updated_by        String?     @db.Uuid

  organization       Organization       @relation(fields: [organization_id], references: [id])
  branch             Branch?            @relation(fields: [branch_id], references: [id])
  parent_account     Account?           @relation("AccountParent", fields: [parent_account_id], references: [id])
  child_accounts     Account[]          @relation("AccountParent")
  fee_payments       FeePayment[]
  ledger_debits      LedgerEntry[]      @relation("LedgerDebit")
  ledger_credits     LedgerEntry[]      @relation("LedgerCredit")
  transfers_from     CashBankTransfer[] @relation("TransferFromAccount")
  transfers_to       CashBankTransfer[] @relation("TransferToAccount")
  zakat_transactions ZakatTransaction[]
  donations          Donation[]

  @@unique([organization_id, code])
  @@index([organization_id, branch_id])
  @@index([fund])
  @@index([type])
  @@index([parent_account_id])
  @@index([is_active])
  @@index([deleted_at])
  @@map("accounts")
}

/// Yearly fee plan per student.
model FeePlan {
  id                 String    @id @default(uuid()) @db.Uuid
  organization_id    String    @db.Uuid
  branch_id          String?   @db.Uuid
  student_id         String    @db.Uuid
  academic_year      Int
  total_amount       Decimal   @db.Decimal(14, 2)
  scholarship_amount Decimal   @default(0) @db.Decimal(14, 2)
  net_payable        Decimal   @db.Decimal(14, 2)
  installment_count  Int       @default(3)
  status             String    @default("draft") // draft | active | closed
  notes              String?
  created_at         DateTime  @default(now()) @db.Timestamptz
  updated_at         DateTime  @updatedAt @db.Timestamptz
  deleted_at         DateTime? @db.Timestamptz
  created_by         String?   @db.Uuid
  updated_by         String?   @db.Uuid

  organization     Organization     @relation(fields: [organization_id], references: [id])
  branch           Branch?          @relation(fields: [branch_id], references: [id])
  student          Student          @relation(fields: [student_id], references: [id])
  fee_installments FeeInstallment[]

  @@unique([student_id, academic_year])
  @@index([organization_id, branch_id])
  @@index([student_id])
  @@index([status])
  @@index([academic_year])
  @@index([deleted_at])
  @@map("fee_plans")
}

/// Installment schedule under a fee plan.
model FeeInstallment {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  fee_plan_id     String    @db.Uuid
  student_id      String    @db.Uuid
  label           String
  amount          Decimal   @db.Decimal(14, 2)
  due_date        DateTime  @db.Date
  is_paid         Boolean   @default(false)
  paid_date       DateTime? @db.Date
  receipt_no      String?
  penalty         Decimal   @default(0) @db.Decimal(14, 2)
  discount        Decimal   @default(0) @db.Decimal(14, 2)
  amount_paid     Decimal   @default(0) @db.Decimal(14, 2)
  status          String    @default("unpaid") // unpaid | partial | paid | overdue
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  fee_plan     FeePlan      @relation(fields: [fee_plan_id], references: [id])
  student      Student      @relation(fields: [student_id], references: [id])
  fee_payments FeePayment[]

  @@index([organization_id, branch_id])
  @@index([fee_plan_id])
  @@index([student_id])
  @@index([due_date])
  @@index([status])
  @@index([is_paid])
  @@index([deleted_at])
  @@map("fee_installments")
}

/// Receipt for a collected installment.
model FeePayment {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  student_id      String    @db.Uuid
  installment_id  String?   @db.Uuid // NULL for ad-hoc payment
  account_id      String    @db.Uuid
  amount          Decimal   @db.Decimal(14, 2)
  method          FeeMethod @default(cash)
  receipt_no      String
  transaction_ref String?
  collected_by    String    @db.Uuid
  collected_at    DateTime  @default(now()) @db.Timestamptz
  idempotency_key String?   @unique
  reverse_of      String?   @unique @db.Uuid
  is_reversed     Boolean   @default(false)
  notes           String?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization    @relation(fields: [organization_id], references: [id])
  branch       Branch?         @relation(fields: [branch_id], references: [id])
  student      Student         @relation(fields: [student_id], references: [id])
  installment  FeeInstallment? @relation(fields: [installment_id], references: [id])
  account      Account         @relation(fields: [account_id], references: [id])
  collector    User            @relation("FeePaymentCollectedBy", fields: [collected_by], references: [id])
  reversal_of  FeePayment?     @relation("FeePaymentReversal", fields: [reverse_of], references: [id])
  reversed_by  FeePayment?     @relation("FeePaymentReversal")

  @@unique([organization_id, receipt_no])
  @@index([organization_id, branch_id])
  @@index([student_id, collected_at])
  @@index([installment_id])
  @@index([account_id])
  @@index([method])
  @@index([collected_at])
  @@index([is_reversed])
  @@index([deleted_at])
  @@map("fee_payments")
}

/// Scholarship / discount granted to a student.
model Scholarship {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  student_id      String    @db.Uuid
  name            String
  type            String    @default("partial") // full | partial
  percentage      Decimal   @default(0) @db.Decimal(5, 2)
  amount_per_year Decimal   @default(0) @db.Decimal(14, 2)
  fund_source     String    @default("general") // general | zakat | donation
  academic_year   Int
  status          String    @default("pending") // pending | approved | active | closed | revoked
  approved_by     String?   @db.Uuid
  approved_at     DateTime? @db.Timestamptz
  note            String?
  expires_at      DateTime? @db.Date
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  student      Student      @relation(fields: [student_id], references: [id])
  approver     User?        @relation("ScholarshipApprovedBy", fields: [approved_by], references: [id])

  @@index([organization_id, branch_id])
  @@index([student_id])
  @@index([status])
  @@index([fund_source])
  @@index([academic_year])
  @@index([deleted_at])
  @@map("scholarships")
}

/// Balanced double-entry row (debit = credit — Golden Flow §3.6).
/// Fund isolation enforced via trigger: when fund = 'zakat', both
/// debit_account_id and credit_account_id must point to zakat accounts.
model LedgerEntry {
  id                String       @id @default(uuid()) @db.Uuid
  organization_id   String       @db.Uuid
  branch_id         String?      @db.Uuid
  voucher_no        String
  date              DateTime     @db.Date
  narration         String
  debit_account_id  String       @db.Uuid
  credit_account_id String       @db.Uuid
  amount            Decimal      @db.Decimal(14, 2)
  fund              FundType     @default(general)
  status            LedgerStatus @default(pending)
  posted_by         String?      @db.Uuid
  posted_at         DateTime?    @db.Timestamptz
  approved_by       String?      @db.Uuid
  source_type       String? // fee_payment | donation | salary | purchase | zakat_transaction | cash_bank_transfer | manual
  source_id         String?      @db.Uuid
  voucher_group_id  String?      @db.Uuid
  is_reversed       Boolean      @default(false)
  reverse_of        String?      @unique @db.Uuid
  created_at        DateTime     @default(now()) @db.Timestamptz
  updated_at        DateTime     @updatedAt @db.Timestamptz
  deleted_at        DateTime?    @db.Timestamptz
  created_by        String?      @db.Uuid
  updated_by        String?      @db.Uuid

  organization       Organization      @relation(fields: [organization_id], references: [id])
  branch             Branch?           @relation(fields: [branch_id], references: [id])
  debit_account      Account           @relation("LedgerDebit", fields: [debit_account_id], references: [id])
  credit_account     Account           @relation("LedgerCredit", fields: [credit_account_id], references: [id])
  poster             User?             @relation("LedgerPostedBy", fields: [posted_by], references: [id])
  approver           User?             @relation("LedgerApprovedBy", fields: [approved_by], references: [id])
  reversal_of        LedgerEntry?      @relation("LedgerReversal", fields: [reverse_of], references: [id])
  reversed_by        LedgerEntry?      @relation("LedgerReversal")
  cash_bank_transfer CashBankTransfer?

  @@unique([organization_id, voucher_no])
  @@index([organization_id, branch_id])
  @@index([date])
  @@index([debit_account_id, credit_account_id])
  @@index([fund])
  @@index([status])
  @@index([source_type, source_id])
  @@index([posted_by])
  @@index([deleted_at])
  @@map("ledger_entries")
}

/// Inter-account transfer (cash ↔ bank ↔ mobile).
model CashBankTransfer {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  voucher_no      String
  from_account_id String    @db.Uuid
  to_account_id   String    @db.Uuid
  amount          Decimal   @db.Decimal(14, 2)
  fund            FundType  @default(general)
  transfer_date   DateTime  @db.Date
  narration       String?
  initiated_by    String    @db.Uuid
  status          String    @default("pending") // pending | completed | reversed
  completed_at    DateTime? @db.Timestamptz
  ledger_entry_id String?   @unique @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  from_account Account      @relation("TransferFromAccount", fields: [from_account_id], references: [id])
  to_account   Account      @relation("TransferToAccount", fields: [to_account_id], references: [id])
  initiator    User         @relation("TransferInitiatedBy", fields: [initiated_by], references: [id])
  ledger_entry LedgerEntry? @relation(fields: [ledger_entry_id], references: [id])

  @@unique([organization_id, voucher_no])
  @@index([organization_id, branch_id])
  @@index([from_account_id])
  @@index([to_account_id])
  @@index([fund])
  @@index([transfer_date])
  @@index([status])
  @@index([deleted_at])
  @@map("cash_bank_transfers")
}

/// Zakat receive / distribute (fund = 'zakat' enforced — account must have
/// fund='zakat').
model ZakatTransaction {
  id               String    @id @default(uuid()) @db.Uuid
  organization_id  String    @db.Uuid
  branch_id        String?   @db.Uuid
  account_id       String    @db.Uuid // must point to a fund='zakat' account
  direction        String // receive | distribute
  student_id       String?   @db.Uuid // recipient — NULL on receive
  recipient_name   String?
  amount           Decimal   @db.Decimal(14, 2)
  transaction_date DateTime  @db.Date
  narration        String?
  purpose          String? // education | food | medical | shelter | other
  handled_by       String    @db.Uuid
  voucher_no       String
  receipt_no       String?
  donor_name       String?
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz
  deleted_at       DateTime? @db.Timestamptz
  created_by       String?   @db.Uuid
  updated_by       String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  account      Account      @relation(fields: [account_id], references: [id])
  student      Student?     @relation(fields: [student_id], references: [id])
  handler      User         @relation("ZakatHandledBy", fields: [handled_by], references: [id])

  @@unique([organization_id, voucher_no])
  @@index([organization_id, branch_id])
  @@index([account_id])
  @@index([student_id])
  @@index([direction])
  @@index([transaction_date])
  @@index([deleted_at])
  @@map("zakat_transactions")
}

/// Public donation (general fund only — public form on `/donate`).
/// honeypot_filled is the anti-bot field (Risk R10).
model Donation {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  account_id      String    @db.Uuid // must point to a fund='general' account
  donor_name      String? // NULL if anonymous
  donor_email     String?
  donor_phone     String?
  amount          Decimal   @db.Decimal(14, 2)
  donation_type   String    @default("general") // general | zakat | sadaqah
  fund            FundType  @default(general)
  donation_date   DateTime  @db.Date
  transaction_ref String?
  receipt_no      String?
  note            String?
  is_anonymous    Boolean   @default(false)
  status          String    @default("pending") // pending | confirmed | failed
  confirmed_by    String?   @db.Uuid
  confirmed_at    DateTime? @db.Timestamptz
  payment_method  String? // card | mobile | bank | cash
  honeypot_filled Boolean   @default(false) // Risk R10 — anti-bot honeypot
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  account      Account      @relation(fields: [account_id], references: [id])
  confirmer    User?        @relation("DonationConfirmedBy", fields: [confirmed_by], references: [id])

  @@unique([organization_id, receipt_no])
  @@index([organization_id, branch_id])
  @@index([account_id])
  @@index([donation_type])
  @@index([status])
  @@index([donation_date])
  @@index([deleted_at])
  @@map("donations")
}

// ============================================================
// OPERATIONS LAYER (12 models)
// ============================================================

/// Stock item (book, pen, uniform, …).
model InventoryItem {
  id               String    @id @default(uuid()) @db.Uuid
  organization_id  String    @db.Uuid
  branch_id        String?   @db.Uuid
  code             String
  name             String
  name_bn          String?
  category         String // book | uniform | stationery | furniture | food | other
  unit             String    @default("piece")
  qty_in_stock     Decimal   @default(0) @db.Decimal(14, 2)
  reorder_level    Decimal   @default(0) @db.Decimal(14, 2)
  unit_cost        Decimal   @default(0) @db.Decimal(14, 2)
  storage_location String?
  is_active        Boolean   @default(true)
  image_url        String?
  description      String?
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz
  deleted_at       DateTime? @db.Timestamptz
  created_by       String?   @db.Uuid
  updated_by       String?   @db.Uuid

  organization   Organization   @relation(fields: [organization_id], references: [id])
  branch         Branch?        @relation(fields: [branch_id], references: [id])
  purchase_items PurchaseItem[]

  @@unique([organization_id, code])
  @@index([organization_id, branch_id])
  @@index([category])
  @@index([name])
  @@index([is_active])
  @@index([deleted_at])
  @@map("inventory_items")
}

/// Purchase order header.
model Purchase {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  po_number       String
  supplier_id     String    @db.Uuid
  order_date      DateTime  @db.Date
  received_date   DateTime? @db.Date
  total_amount    Decimal   @default(0) @db.Decimal(14, 2)
  status          String    @default("draft") // draft | pending | approved | received | cancelled
  requested_by    String    @db.Uuid
  approved_by     String?   @db.Uuid
  approved_at     DateTime? @db.Timestamptz
  note            String?
  payment_status  String    @default("unpaid") // unpaid | partial | paid
  paid_amount     Decimal   @default(0) @db.Decimal(14, 2)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization   Organization   @relation(fields: [organization_id], references: [id])
  branch         Branch?        @relation(fields: [branch_id], references: [id])
  supplier       Supplier       @relation(fields: [supplier_id], references: [id])
  requester      User           @relation("PurchaseRequestedBy", fields: [requested_by], references: [id])
  approver       User?          @relation("PurchaseApprovedBy", fields: [approved_by], references: [id])
  purchase_items PurchaseItem[]

  @@unique([organization_id, po_number])
  @@index([organization_id, branch_id])
  @@index([supplier_id])
  @@index([status])
  @@index([order_date])
  @@index([payment_status])
  @@index([deleted_at])
  @@map("purchases")
}

/// Line items under a purchase. Junction-as-entity (carries qty_ordered,
/// qty_received, unit_cost, line_total).
model PurchaseItem {
  id                String    @id @default(uuid()) @db.Uuid
  organization_id   String    @db.Uuid
  branch_id         String?   @db.Uuid
  purchase_id       String    @db.Uuid
  inventory_item_id String    @db.Uuid
  qty_ordered       Decimal   @db.Decimal(14, 2)
  qty_received      Decimal   @default(0) @db.Decimal(14, 2)
  unit_cost         Decimal   @db.Decimal(14, 2)
  line_total        Decimal   @db.Decimal(14, 2)
  note              String?
  created_at        DateTime  @default(now()) @db.Timestamptz
  updated_at        DateTime  @updatedAt @db.Timestamptz
  deleted_at        DateTime? @db.Timestamptz
  created_by        String?   @db.Uuid
  updated_by        String?   @db.Uuid

  organization   Organization  @relation(fields: [organization_id], references: [id])
  branch         Branch?       @relation(fields: [branch_id], references: [id])
  purchase       Purchase      @relation(fields: [purchase_id], references: [id])
  inventory_item InventoryItem @relation(fields: [inventory_item_id], references: [id])

  @@index([organization_id, branch_id])
  @@index([purchase_id])
  @@index([inventory_item_id])
  @@index([deleted_at])
  @@map("purchase_items")
}

/// Vendor master.
model Supplier {
  id                  String    @id @default(uuid()) @db.Uuid
  organization_id     String    @db.Uuid
  branch_id           String?   @db.Uuid
  code                String
  name                String
  name_bn             String?
  contact_person      String?
  phone               String?
  email               String?
  address             String?
  tin                 String?
  outstanding_balance Decimal   @default(0) @db.Decimal(14, 2)
  total_purchased     Decimal   @default(0) @db.Decimal(14, 2)
  total_paid          Decimal   @default(0) @db.Decimal(14, 2)
  is_active           Boolean   @default(true)
  notes               String?
  created_at          DateTime  @default(now()) @db.Timestamptz
  updated_at          DateTime  @updatedAt @db.Timestamptz
  deleted_at          DateTime? @db.Timestamptz
  created_by          String?   @db.Uuid
  updated_by          String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  purchases    Purchase[]

  @@unique([organization_id, code])
  @@index([organization_id, branch_id])
  @@index([name])
  @@index([is_active])
  @@index([deleted_at])
  @@map("suppliers")
}

/// Fixed asset (furniture, equipment, IT, vehicle, building, ...).
model Asset {
  id                       String    @id @default(uuid()) @db.Uuid
  organization_id          String    @db.Uuid
  branch_id                String?   @db.Uuid
  asset_code               String
  name                     String
  name_bn                  String?
  category                 String // furniture | equipment | it | vehicle | building | other
  purchase_date            DateTime  @db.Date
  purchase_value           Decimal   @default(0) @db.Decimal(14, 2)
  current_value            Decimal   @default(0) @db.Decimal(14, 2)
  depreciation_rate        Decimal   @default(0) @db.Decimal(5, 2)
  depreciation_date        DateTime? @db.Date
  location                 String?
  status                   String    @default("in-use") // in-use | stored | transferred | disposed | under-repair
  transferred_to_branch_id String?   @db.Uuid
  transferred_at           DateTime? @db.Date
  disposed_by              String?   @db.Uuid
  disposed_at              DateTime? @db.Date
  disposal_reason          String?
  image_url                String?
  created_at               DateTime  @default(now()) @db.Timestamptz
  updated_at               DateTime  @updatedAt @db.Timestamptz
  deleted_at               DateTime? @db.Timestamptz
  created_by               String?   @db.Uuid
  updated_by               String?   @db.Uuid

  organization          Organization @relation(fields: [organization_id], references: [id])
  branch                Branch?      @relation(fields: [branch_id], references: [id])
  transferred_to_branch Branch?      @relation("AssetTransferredToBranch", fields: [transferred_to_branch_id], references: [id])
  disposer              User?        @relation("AssetDisposedBy", fields: [disposed_by], references: [id])

  @@unique([organization_id, asset_code])
  @@index([organization_id, branch_id])
  @@index([category])
  @@index([status])
  @@index([purchase_date])
  @@index([deleted_at])
  @@map("assets")
}

/// Hostel room.
model HostelRoom {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  room_number     String
  building        String?
  floor           Int       @default(1)
  capacity        Int       @default(4)
  gender          Gender?
  is_active       Boolean   @default(true)
  notes           String?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  beds         HostelBed[]

  @@unique([organization_id, branch_id, room_number])
