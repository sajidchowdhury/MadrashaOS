/// Class × Day × Period × Subject × Teacher slot.
model Routine {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  class_id        String    @db.Uuid
  section_id      String?   @db.Uuid
  subject_id      String    @db.Uuid
  teacher_id      String    @db.Uuid
  academic_year   Int
  day_of_week     String // sun | mon | tue | wed | thu | fri | sat
  period_number   Int
  start_time      DateTime  @db.Time
  end_time        DateTime  @db.Time
  room            String?
  is_break        Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  class        Class        @relation(fields: [class_id], references: [id])
  section      Section?     @relation(fields: [section_id], references: [id])
  subject      Subject      @relation(fields: [subject_id], references: [id])
  teacher      Teacher      @relation(fields: [teacher_id], references: [id])

  @@unique([organization_id, academic_year, class_id, section_id, day_of_week, period_number])
  @@index([organization_id, branch_id])
  @@index([class_id, section_id])
  @@index([teacher_id])
  @@index([subject_id])
  @@index([academic_year])
  @@index([deleted_at])
  @@map("routines")
}

/// One teacher's attendance pass for one class+section+date.
model AttendanceSession {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  class_id        String    @db.Uuid
  section_id      String?   @db.Uuid
  date            DateTime  @db.Date
  taken_by        String    @db.Uuid // teacher user id
  academic_year   Int
  period          String    @default("full") // morning | afternoon | full
  submitted_at    DateTime? @db.Timestamptz
  is_locked       Boolean   @default(false)
  device_id       String? // offline device ID (Risk R6)
  sync_status     String    @default("synced") // pending | synced | conflict
  total_present   Int?
  total_absent    Int?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization       Organization       @relation(fields: [organization_id], references: [id])
  branch             Branch?            @relation(fields: [branch_id], references: [id])
  class              Class              @relation(fields: [class_id], references: [id])
  section            Section?           @relation(fields: [section_id], references: [id])
  taken_by_user      User               @relation("AttendanceTakenBy", fields: [taken_by], references: [id])
  attendance_records AttendanceRecord[]

  @@unique([organization_id, class_id, section_id, date, period])
  @@index([organization_id, branch_id])
  @@index([class_id, section_id, date])
  @@index([taken_by])
  @@index([date])
  @@index([sync_status])
  @@index([deleted_at])
  @@map("attendance_sessions")
}

/// Per-student attendance row inside a session.
model AttendanceRecord {
  id              String           @id @default(uuid()) @db.Uuid
  organization_id String           @db.Uuid
  branch_id       String?          @db.Uuid
  session_id      String           @db.Uuid
  student_id      String           @db.Uuid
  status          AttendanceStatus @default(present)
  note            String?
  recorded_at     DateTime         @default(now()) @db.Timestamptz
  recorded_by     String?          @db.Uuid
  created_at      DateTime         @default(now()) @db.Timestamptz
  updated_at      DateTime         @updatedAt @db.Timestamptz
  deleted_at      DateTime?        @db.Timestamptz
  created_by      String?          @db.Uuid
  updated_by      String?          @db.Uuid

  organization Organization      @relation(fields: [organization_id], references: [id])
  branch       Branch?           @relation(fields: [branch_id], references: [id])
  session      AttendanceSession @relation(fields: [session_id], references: [id])
  student      Student           @relation(fields: [student_id], references: [id])
  recorder     User?             @relation("AttendanceRecordedBy", fields: [recorded_by], references: [id])

  @@unique([session_id, student_id])
  @@index([organization_id, branch_id])
  @@index([student_id])
  @@index([status])
  @@index([recorded_at])
  @@index([deleted_at])
  @@map("attendance_records")
}

/// Exam definition (term, date, class, subject).
model Exam {
