/// Parent / guardian contact. A guardian can be linked to multiple students
/// (siblings).
model Guardian {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  name            String
  name_bn         String?
  phone           String
  email           String?
  occupation      String?
  relation        String    @default("father") // father | mother | uncle | aunt | guardian | other
  nid_number      String?
  annual_income   Decimal?  @db.Decimal(14, 2)
  is_primary      Boolean   @default(true)
  address         String?
  user_id         String?   @unique @db.Uuid // linked user account (guardian portal login)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization      Organization      @relation(fields: [organization_id], references: [id])
  branch            Branch?           @relation(fields: [branch_id], references: [id])
  user              User?             @relation(fields: [user_id], references: [id])
  student_guardians StudentGuardian[]

  @@unique([organization_id, phone])
  @@index([organization_id, branch_id])
  @@index([user_id])
  @@index([deleted_at])
  @@map("guardians")
}

/// M:M junction between students and guardians — a student may have multiple
/// guardians; a guardian may have multiple children.
model StudentGuardian {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  student_id      String    @db.Uuid
  guardian_id     String    @db.Uuid
  relation        String // father | mother | uncle | aunt | guardian | other
  is_primary      Boolean   @default(false)
  can_pickup      Boolean   @default(true)
  receive_sms     Boolean   @default(true)
  receive_email   Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  student      Student      @relation(fields: [student_id], references: [id])
  guardian     Guardian     @relation(fields: [guardian_id], references: [id])

  @@unique([student_id, guardian_id])
  @@index([organization_id, branch_id])
  @@index([student_id])
  @@index([guardian_id])
  @@index([deleted_at])
  @@map("student_guardians")
}

/// Teacher profile (1:1 with a users row of role `teacher`).
model Teacher {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  user_id         String    @db.Uuid
  employee_code   String
  designation     String? // lecturer | senior-lecturer | head-teacher | qari | qaria | ...
  qualification   String?
  specialization  String? // Quran, Hadith, Fiqh, Bangla, Math, ...
  joined_at       DateTime  @db.Date
  left_at         DateTime? @db.Date
  salary          Decimal?  @db.Decimal(14, 2)
  status          String    @default("active") // active | on-leave | resigned
  phone           String?
  nid_number      String?
  photo_url       String?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization        Organization        @relation(fields: [organization_id], references: [id])
  branch              Branch?             @relation(fields: [branch_id], references: [id])
  user                User                @relation(fields: [user_id], references: [id])
  sections_taught     Section[]           @relation("SectionClassTeacher")
  routines            Routine[]
  teacher_assignments TeacherAssignment[]

  @@unique([organization_id, employee_code])
  @@unique([user_id])
  @@index([organization_id, branch_id])
  @@index([user_id])
  @@index([status])
  @@index([joined_at])
  @@index([deleted_at])
  @@map("teachers")
}

/// Non-teaching staff (accountant, librarian, storekeeper, ...). 1:1 with a
/// users row.
model Employee {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
