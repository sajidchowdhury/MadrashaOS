/// Admission pipeline (applied → interviewed → approved → registered / rejected).
/// When status = 'registered', a Student row is created and student_id is set.
model Admission {
  id                 String          @id @default(uuid()) @db.Uuid
  organization_id    String          @db.Uuid
  branch_id          String?         @db.Uuid
  applicant_name     String
  applicant_name_bn  String?
  parent_name        String
  parent_phone       String
  parent_email       String?
  desired_class      String?
  desired_program    String? // alim | nazera | hifz | tajweed | arabic | one-to-one
  previous_education Json?
  notes              String?
  status             AdmissionStatus @default(applied)
  student_id         String?         @db.Uuid // set when registered
  requested_by       String?         @db.Uuid // NULL for public form submissions
  decided_by         String?         @db.Uuid
  decided_at         DateTime?       @db.Timestamptz
  rejection_reason   String?
  submitted_at       DateTime        @default(now()) @db.Timestamptz
  form_source        String          @default("public") // public | office
  created_at         DateTime        @default(now()) @db.Timestamptz
  updated_at         DateTime        @updatedAt @db.Timestamptz
  deleted_at         DateTime?       @db.Timestamptz
  created_by         String?         @db.Uuid
  updated_by         String?         @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  student      Student?     @relation(fields: [student_id], references: [id])
  requester    User?        @relation("AdmissionRequestedBy", fields: [requested_by], references: [id])
  decider      User?        @relation("AdmissionDecidedBy", fields: [decided_by], references: [id])

  @@index([organization_id, branch_id])
  @@index([status])
  @@index([applicant_name])
  @@index([parent_phone])
  @@index([submitted_at])
  @@index([deleted_at])
  @@map("admissions")
}

/// Teacher × Class × Section × Subject assignment. Used by routines + marks
/// entry scoping. Ternary junction modeled as a full entity with metadata
/// (academic_year, is_active).
model TeacherAssignment {
  id              String    @id @default(uuid()) @db.Uuid
  organization_id String    @db.Uuid
  branch_id       String?   @db.Uuid
  teacher_id      String    @db.Uuid
  class_id        String    @db.Uuid
  section_id      String?   @db.Uuid // NULL = all sections
  subject_id      String    @db.Uuid
  academic_year   Int
  is_active       Boolean   @default(true)
  notes           String?
  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @updatedAt @db.Timestamptz
  deleted_at      DateTime? @db.Timestamptz
  created_by      String?   @db.Uuid
  updated_by      String?   @db.Uuid

  organization Organization @relation(fields: [organization_id], references: [id])
  branch       Branch?      @relation(fields: [branch_id], references: [id])
  teacher      Teacher      @relation(fields: [teacher_id], references: [id])
  class        Class        @relation(fields: [class_id], references: [id])
  section      Section?     @relation(fields: [section_id], references: [id])
  subject      Subject      @relation(fields: [subject_id], references: [id])

  @@unique([organization_id, academic_year, teacher_id, class_id, section_id, subject_id])
  @@index([organization_id, branch_id])
  @@index([teacher_id])
  @@index([class_id, section_id])
  @@index([subject_id])
  @@index([is_active])
  @@index([deleted_at])
  @@map("teacher_assignments")
}

